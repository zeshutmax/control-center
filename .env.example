# Postgres connection string.
# Local dev: postgresql://<user>@localhost:5432/control_center_dev
# Production: the DO managed Postgres connection string (require SSL).
DATABASE_URL=

# GitHub personal access token (classic or fine-grained) with repo read access.
# Used to list your repos and read project.yaml manifests. Read-only usage.
GITHUB_TOKEN=

# GitHub username or org whose repos are synced.
GITHUB_OWNER=

# DigitalOcean API token with read scope. Used to list apps and deployments.
DO_API_TOKEN=

# Secret used to salt visitor hashes for the analytics pixel.
# Any long random string; rotate to reset visitor identities.
PIXEL_SECRET=

# Optional bearer token protecting /api/mcp and /api/sync.
# Leave empty in local dev to allow unauthenticated access.
# REQUIRED in production; both endpoints refuse to run without it there.
CONTROL_CENTER_TOKEN=
